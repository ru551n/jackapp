# JackApp configuration. Copy to .env and fill in. Reference: docs/platform/env.md
# Empty values mean "unset" (the default applies). Never commit .env.

# --- Application -------------------------------------------------------------
# External origin, as users see it through the reverse proxy.
PUBLIC_URL=https://jackapp.example.se
# ≥32 random characters; signs the adult-gate cookie. Generate: openssl rand -hex 32
# The app refuses to start while this is still a placeholder (change-me…).
APP_SECRET=change-me-to-64-hex-chars-from-openssl-rand-hex-32
# Comma-separated IPs/CIDRs of the reverse proxy (X-Forwarded-* trusted only from these). Empty = none.
# Find the real subnet with `docker network inspect jackapp_egress` (see docs/platform/reverse-proxy.md).
TRUST_PROXY=
LOG_LEVEL=info
# Defaults are right for the Docker image; change only for local runs.
# HOST defaults to 127.0.0.1 (loopback); the Docker image sets HOST=0.0.0.0.
# NODE_ENV=production
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=/data
# WEB_DIST_DIR=/app/dist

# --- Database ----------------------------------------------------------------
# compose.yaml builds DATABASE_URL from these. Use a URL-safe password (openssl rand -hex 24);
# migrate refuses to run while POSTGRES_PASSWORD is still change-me.
POSTGRES_USER=jackapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jackapp
# Only for running outside Compose (npm run start / dev:server / db:migrate):
# DATABASE_URL=postgres://jackapp:change-me@localhost:5432/jackapp

# --- AI capabilities (docs/platform/ai-providers.md) ---------------------------
# Per capability: AI_<CAP>_PROVIDER, _BASE_URL, _API_KEY, _MODEL, _TIMEOUT_MS (+ _STRUCTURED for TEXT/VISION).
# Providers: openai | anthropic | openai-compatible | anthropic-compatible | mock (dev/test).
# Unset provider = capability disabled. TEXT is required for the app to be ready.

# Each block below is self-contained: keep exactly ONE block per capability uncommented (later
# lines override earlier ones). Never leave an empty `KEY=` after a block you uncomment.

# Text (required). Pick ONE block.
# OpenAI:
AI_TEXT_PROVIDER=openai
AI_TEXT_API_KEY=sk-your-openai-key
AI_TEXT_MODEL=gpt-5-mini
# Anthropic:
# AI_TEXT_PROVIDER=anthropic
# AI_TEXT_API_KEY=sk-ant-your-anthropic-key
# AI_TEXT_MODEL=claude-sonnet-4-5
# LAN OpenAI-compatible server (llama.cpp, vLLM, Ollama, LM Studio…). Use the LAN IP, not localhost.
# Ollama listens on 127.0.0.1 by default: start it with OLLAMA_HOST=0.0.0.0 to reach it from Docker.
# AI_TEXT_PROVIDER=openai-compatible
# AI_TEXT_BASE_URL=http://192.168.1.50:8080/v1
# AI_TEXT_MODEL=qwen3-32b
# Optional for every text block: request timeout and structured-output mode
# (auto | json_schema | json_mode | prompt).
AI_TEXT_TIMEOUT_MS=120000
AI_TEXT_STRUCTURED=auto

# Vision (study-material reading: photos and PDF pages). Optional; disabled while commented out.
# OpenAI:
# AI_VISION_PROVIDER=openai
# AI_VISION_API_KEY=sk-your-openai-key
# AI_VISION_MODEL=gpt-5-mini
# LAN OpenAI-compatible vision model:
# AI_VISION_PROVIDER=openai-compatible
# AI_VISION_BASE_URL=http://192.168.1.50:8080/v1
# AI_VISION_MODEL=qwen2.5-vl-32b
# AI_VISION_TIMEOUT_MS=120000
# AI_VISION_STRUCTURED=auto

# Image generation. Optional; disabled while commented out.
# AI_IMAGE_PROVIDER=openai
# AI_IMAGE_API_KEY=sk-your-openai-key
# AI_IMAGE_MODEL=gpt-image-1
# AI_IMAGE_TIMEOUT_MS=300000

# Embeddings. Optional; disabled while commented out.
# AI_EMBEDDING_PROVIDER=openai
# AI_EMBEDDING_API_KEY=sk-your-openai-key
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_TIMEOUT_MS=120000

# Web research: searxng | brave | tavily. Optional (no model); disabled while commented out.
# SearXNG on the LAN:
# AI_RESEARCH_PROVIDER=searxng
# AI_RESEARCH_BASE_URL=http://192.168.1.50:8888
# Brave Search API:
# AI_RESEARCH_PROVIDER=brave
# AI_RESEARCH_API_KEY=your-brave-key
# AI_RESEARCH_TIMEOUT_MS=120000

# --- Features ----------------------------------------------------------------
# A feature is active only when enabled AND its capability is configured.
FEATURE_WEB_RESEARCH=true
FEATURE_EXTERNAL_ASSETS=true
FEATURE_IMAGE_GENERATION=true
# false = refuse to start with openai/anthropic providers (keep all data on your network).
ALLOW_CLOUD_AI=true
# false = refuse to start with *-compatible (self-hosted) providers.
ALLOW_LOCAL_AI=true

# --- Limits ------------------------------------------------------------------
LIMIT_AI_REQUESTS_PER_HOUR=2000
LIMIT_AI_CONCURRENCY=4
LIMIT_QUEUED_JOBS=500
LIMIT_JOB_TIMEOUT_SECONDS=1200
LIMIT_UPLOAD_FILE_MB=30
LIMIT_UPLOAD_TOTAL_MB=300
LIMIT_UPLOAD_PAGES=80
LIMIT_IMAGES_PER_DAY=300
WORKER_CONCURRENCY=2
UPLOAD_FAILED_RETENTION_HOURS=168

# --- Build -------------------------------------------------------------------
# 1 = skip Piper speech clips in the image build (faster, ~210 MB smaller; no bundled voices).
JACKAPP_SKIP_SPEECH=0
